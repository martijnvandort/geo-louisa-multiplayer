# Mapbox GL basemap. Leave blank to use the free Carto / OSM dark basemap.
# The game does not require a Mapbox Studio style.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Optional. Two browsers on this computer share a game through the local server.
# Leave these blank. Do not put a secret or service_role key in this file.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional alias accepted by the client if you prefer the new key name.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
